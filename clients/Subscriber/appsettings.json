{
  "Broker": {
    "Host": "localhost",
    "Port": 1883
  },
  "Subscriber": {
    "ClientId": "console-mqtt-subscriber",
    "Topics": [
      "test/topic",
      "sensor/+/temperature",
      "device/#"
    ],
    "Qos": 0,
    "CleanSession": true,
    "KeepAliveSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}

