@page "/metrics"
@using Broker.Contracts
@using Broker.AdminUI.Services
@inject IBrokerApiClient BrokerApiClient
@inject ILogger<Metrics> Logger
@rendermode InteractiveServer

<PageTitle>Broker Metrics</PageTitle>

<div class="container-fluid">
    <h1>Broker Metrics</h1>

    @if (_loading)
    {
        <div class="alert alert-info">Loading metrics...</div>
    }
    else if (_error != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @_error
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadMetrics">Retry</button>
        </div>
    }
    else if (_metrics != null)
    {
        <div class="row mt-4">
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Connected Clients</h5>
                        <h2 class="text-primary">@_metrics.ConnectedClients</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Active Subscriptions</h5>
                        <h2 class="text-success">@_metrics.ActiveSubscriptions</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Messages Per Second</h5>
                        <h2 class="text-info">@_metrics.MessagesPerSecond.ToString("F2")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Total Messages Published</h5>
                        <h2 class="text-primary">@_metrics.TotalMessagesPublished.ToString("N0")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Total Messages Received</h5>
                        <h2 class="text-primary">@_metrics.TotalMessagesReceived.ToString("N0")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Retained Messages</h5>
                        <h2 class="text-warning">@_metrics.RetainedMessages</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Pending Messages</h5>
                        <h2 class="text-danger">@_metrics.PendingMessages</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="LoadMetrics">Refresh</button>
            <button class="btn btn-secondary ms-2" @onclick="StartAutoRefresh">Start Auto-Refresh</button>
            <button class="btn btn-secondary ms-2" @onclick="StopAutoRefresh">Stop Auto-Refresh</button>
            @if (_autoRefreshEnabled)
            {
                <span class="ms-2 text-muted">Auto-refreshing every 5 seconds...</span>
            }
        </div>
    }
</div>

@code {
    private BrokerMetricsDto? _metrics;
    private bool _loading = true;
    private string? _error;
    private System.Threading.Timer? _refreshTimer;
    private bool _autoRefreshEnabled;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetrics();
    }

    private async Task LoadMetrics()
    {
        try
        {
            _loading = true;
            _error = null;
            StateHasChanged();

            _metrics = await BrokerApiClient.GetMetricsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Error loading metrics");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void StartAutoRefresh()
    {
        if (_refreshTimer != null)
        {
            return;
        }

        _autoRefreshEnabled = true;
        _refreshTimer = new System.Threading.Timer(async _ => await InvokeAsync(LoadMetrics), null, TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    private void StopAutoRefresh()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
        _autoRefreshEnabled = false;
    }
}
