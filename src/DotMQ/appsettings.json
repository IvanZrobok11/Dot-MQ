{
  "Broker": {
    "TcpPort": 1883,
    "WebSocketPort": 8080,
    "MaxConnections": 1000,
    "KeepAliveTimeoutSeconds": 60,
    "EnableWebSocket": true
  },
  "Storage": {
    "DataPath": "./data",
    "DatabasePath": "./data/mqtt_broker.db",
    "SessionRetentionPeriod": "7.00:00:00",
    "PendingMessageRetentionPeriod": "1.00:00:00",
    "Qos2StateRetentionPeriod": "1.00:00:00",
    "CleanupInterval": "01:00:00"
  },
  "Api": {
    "Port": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  }
}

